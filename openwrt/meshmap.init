#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

DATA_ROOT=/meshmap
DATA_LABEL=meshmap-data

# Print the first block device holding an ext4 file system labeled
# $DATA_LABEL. AREDN ships no blkid or block-mount, so this reads the
# superblock: magic 0xEF53 at byte 1080, volume name at byte 1144.
find_data_disk() {
    local sys dev magic label
    for sys in /sys/class/block/*; do
        dev="/dev/${sys##*/}"
        [ -b "$dev" ] || continue
        magic=$(dd if="$dev" bs=8 skip=135 count=1 2>/dev/null | hexdump -n 2 -e '2/1 "%02x"')
        [ "$magic" = "53ef" ] || continue
        label=$(dd if="$dev" bs=8 skip=143 count=2 2>/dev/null | tr -d '\000')
        if [ "$label" = "$DATA_LABEL" ]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

mount_data() {
    local dev
    if grep -q "^[^ ]* $DATA_ROOT " /proc/mounts; then
        mkdir -p "$DATA_ROOT/data"
        return 0
    fi
    dev=$(find_data_disk) || return 0
    mkdir -p "$DATA_ROOT"
    if mount -t ext4 -o noatime "$dev" "$DATA_ROOT"; then
        mkdir -p "$DATA_ROOT/data"
    else
        logger -t meshmap "Failed to mount $dev on $DATA_ROOT, the walker will not run"
    fi
}

start_service() {
    mount_data
    /usr/libexec/meshmap/mapurl boot

    procd_open_instance scheduler
    procd_set_param command /usr/libexec/meshmap/scheduler
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
