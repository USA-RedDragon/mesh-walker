#!/bin/sh
# Run the walker once a minute after start when there is no data yet, then
# every hour at minute 30. AREDN 4.26 has no crond, and its /etc/cron.hourly
# runs relative to boot, so this loop does the scheduling.
#
# The walker only runs when the meshmap-data disk is mounted on /meshmap, so
# it never writes the large data file to the node's flash.

DATA_ROOT=/meshmap
MOUNTS=/proc/mounts
OUT=$DATA_ROOT/data/out.json
child=
warned=

# Fewer parallel fetches on nodes with less than 256 MB of RAM. Each fetch
# holds one decoded sysinfo response in memory.
CONCURRENCY=64
mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
if [ -n "$mem_kb" ] && [ "$mem_kb" -lt 262144 ]; then
    CONCURRENCY=16
fi

pause() {
    sleep "$1" &
    child=$!
    wait "$child"
    child=
}

walk() {
    # Remove leftovers from a walk that was killed before it could clean up.
    rm -f "$OUT".responses-* "$OUT.new"
    nice -n 19 /usr/bin/mesh-walker --out "$OUT" --concurrency "$CONCURRENCY" --progress-interval 5m &
    child=$!
    wait "$child"
    child=
}

data_mounted() {
    grep -q "^[^ ]* $DATA_ROOT " "$MOUNTS"
}

# Walk if the data disk is mounted. Otherwise log at most once per hour.
maybe_walk() {
    if data_mounted; then
        mkdir -p "$DATA_ROOT/data"
        walk
        return
    fi
    now=$(date +%Y%m%d%H)
    if [ "$warned" != "$now" ]; then
        warned=$now
        logger -t meshmap "No meshmap-data disk is mounted on $DATA_ROOT, so the walk is skipped"
    fi
}

trap '[ -n "$child" ] && kill "$child" 2>/dev/null; exit 0' TERM INT

if ! data_mounted || [ ! -s "$OUT" ]; then
    pause 60
    maybe_walk
fi

last=
while :; do
    pause 20
    [ "$(date +%M)" = 30 ] || continue
    hour=$(date +%Y%m%d%H)
    [ "$hour" = "$last" ] && continue
    last=$hour
    maybe_walk
done
